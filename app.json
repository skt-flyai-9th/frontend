{
  "expo": {
    "name": "Reals",
    "slug": "reals",
    "scheme": "reals",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yeoljeong2.reals",
      "infoPlist": {
        "NSCameraUsageDescription": "가게 홍보 영상을 촬영하기 위해 카메라를 사용합니다.",
        "NSMicrophoneUsageDescription": "영상에 소리를 담기 위해 마이크를 사용합니다.",
        "NSPhotoLibraryAddUsageDescription": "완성한 영상을 사진첩에 저장하기 위해 사용합니다.",
        "NSPhotoLibraryUsageDescription": "가게 사진을 불러오기 위해 사용합니다.",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories",
          "youtube",
          "naversearchapp"
        ]
      }
    },
    "android": {
      "package": "com.yeoljeong2.reals",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "가게 홍보 영상을 촬영하기 위해 카메라를 사용합니다.",
          "microphonePermission": "영상에 소리를 담기 위해 마이크를 사용합니다.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "가게 사진을 불러오기 위해 사용합니다.",
          "savePhotosPermission": "완성한 영상을 사진첩에 저장하기 위해 사용합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-video",
      "expo-font",
      "expo-secure-store",
      "expo-file-system",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://sarils.p-e.kr",
      "mockDomains": [],
      "eas": {
        "projectId": "074a2259-8b4c-402e-bb89-eb04bf1bfaa6"
      },
      "apiNote": "mockDomains 를 비우면 전부 실서버입니다. 특정 도메인만 되돌리려면 이름을 넣으세요 (auth/store/project/format/quiz/plan/shoot/edit/publish/analytics). 서버에 아직 없는 경로(R06 질문형·R13 평가)는 src/api/http.ts 의 SERVER_MISSING_SUFFIXES 가 처리합니다."
    },
    "owner": "zqwerty23"
  }
}
